# Token server configuration (copy into your host's env settings, or export
# these in the shell before running `npm run server`). Never commit real
# secrets, and never put the App Secret in the web app's config.js.

# From the Nexconn Console -> your app -> Key Management
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=

# Nexconn Server API base URL for your app's data center.
# Default below is the Singapore data center used in the official docs.
NEXCONN_API_BASE=https://api.sg-light-api.com

# Port for the token server (hosts like Render/Railway set this for you)
PORT=8787
